# ─────────────────────────────────────────────────────────────
# 构建产物
# ─────────────────────────────────────────────────────────────
# PyInstaller 工作目录（中间文件 + build/pycache 字节码缓存）
build/

# 产物目录：exe 不进版本库（20 MB 的二进制，请挂到 GitHub Releases）
dist/*
# 但插件包是「源码」，不是构建产物，要跟着走
!dist/plugins/
!dist/plugins/**
# 1.0.x 的账本曾经写在插件目录里（现役账本在 %LOCALAPPDATA%\DeepSeekHarness\data\，
# 不在版本库范围内）。这里留个兜底规则，**别删文件**：里面是累计的用量。
dist/plugins/*/data/

# 本地插件：只在本机用，不进版本库（插件管理器照常扫得到它）
# 第三方插件目录整体忽略：里面的插件（如 dsh-cf、review）不提交 git，
# 但外壳启动时和 plugins/ 一起扫描、一起参与加载，管理器里标「第三方」。
dist/plugins-third-party/

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/

# 虚拟环境
.venv/
venv/
env/
ENV/

# ─────────────────────────────────────────────────────────────
# 本地工作目录（含个人记忆 / 技能，纯本地，不进版本库）
# ─────────────────────────────────────────────────────────────
.workbuddy/

# ─────────────────────────────────────────────────────────────
# 编辑器 / IDE
# ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─────────────────────────────────────────────────────────────
# 操作系统
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
